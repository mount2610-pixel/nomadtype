rules_version = '2';

// NomadType — Cloud Firestore аюулгүй байдлын дүрэм.
// Firebase Console → Firestore Database → Rules хэсэгт бүтнээр нь хуулж Publish дарна.

service cloud.firestore {
  match /databases/{database}/documents {

    // leaderboards/{хэл_секунд}/scores/{uid}
    match /leaderboards/{board}/scores/{uid} {
      // Жагсаалтыг хүн бүр харна.
      allow read: if true;

      // Зөвхөн нэвтэрсэн хэрэглэгч өөрийн мөрийг, зөвхөн илүү өндөр дүнгээр бичнэ.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && board in ['mn_15', 'mn_30', 'mn_60', 'en_15', 'en_30', 'en_60']
        && request.resource.data.keys().hasOnly(['uid', 'name', 'wpm', 'acc', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.wpm is int
        && request.resource.data.wpm >= 0
        && request.resource.data.wpm <= 250
        && request.resource.data.acc is int
        && request.resource.data.acc >= 90
        && request.resource.data.acc <= 100
        && request.resource.data.updatedAt == request.time
        && (resource == null || request.resource.data.wpm > resource.data.wpm);

      // Хэрэглэгч өөрийн мөрийг устгаж болно.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // waitlist/{имэйл} — "Premium удахгүй" хүлээлгийн жагсаалт.
    // Хэн ч шинэ имэйл нэмж болно, гэхдээ хэн ч уншиж, засаж, устгаж чадахгүй.
    // (Имэйлүүдийг зөвхөн та Firebase Console-оос харна.)
    match /waitlist/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'lang', 'source', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email == email
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && request.resource.data.lang in ['mn', 'en']
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 20
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Бусад бүх зүйл хаалттай.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
